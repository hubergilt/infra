<network>
  <!-- lab-clients — 10.0.4.0/24 isolated, fw01 is gateway (10.0.4.1) -->
  <!-- Hosts: client01 and domain-joined workstations -->
  <!-- DHCP relayed by fw01 to dhcp01 (10.0.1.30); pool .50-.200 -->
  <name>lab-clients</name>
  <bridge delay="0" name="virbr-clients" stp="on"></bridge>
  <ip address="10.0.4.254" netmask="255.255.255.0"></ip>
  <dns enable="no"></dns>
</network>
