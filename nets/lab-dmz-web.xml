<network>
  <!-- lab-dmz-web — 10.0.2.0/24 isolated, fw01 is gateway (10.0.2.1) -->
  <!-- Hosts: waf01 (10.0.2.12), web01 (10.0.2.11), lb01 (10.0.2.10), rodc01 (10.0.2.15) -->
  <!-- No DHCP — all static. Internet access allowed (HTTP/HTTPS only). -->
  <name>lab-dmz-web</name>
  <bridge delay="0" name="virbr-dmzweb" stp="on"></bridge>
  <ip address="10.0.2.254" netmask="255.255.255.0"></ip>
  <dns enable="no"></dns>
</network>
