#version=OL10
# ks-ol10.cfg — Unattended Oracle Linux 10.1 install for ora01 (data tier)
# Bakes in README.md Phases 1-6 (packages, groups, oracle user, kernel
# params, limits, THP, directories) so the OS is Oracle-DB-ready at
# first boot. Phases 7-14 (software install, DB creation, services)
# are handled by deploy-oracle-db.sh after first boot.
#
# Usage: injected via create-ora01-unattend.sh (virt-install --initrd-inject)

# ── Basics ──────────────────────────────────────────────────────
lang en_US.UTF-8
keyboard us
timezone UTC --utc
text
reboot

# ── Network — static, data tier (10.0.6.0/24) ──────────────────
network --bootproto=static --ip=10.0.6.80 --netmask=255.255.255.0 --gateway=10.0.6.1 --nameserver=10.0.7.10,10.0.7.11 --hostname=ora01.ad.lab --device=link --activate

# ── Root / admin account ────────────────────────────────────────
# Root login locked; use the 'huber' local admin (sudo) for day-to-day
# access, matching the rest of the lab (bastion via jump01).
rootpw --lock
user --name=huber --groups=wheel --plaintext --password=huber
sshkey --username=huber "ssh-rsa  huber@pop-os"

# ── Disk layout ──────────────────────────────────────────────────
zerombr
clearpart --all --initlabel
autopart --type=lvm
bootloader --location=mbr

# ── Install source (self, from the mounted DVD) ─────────────────
cdrom

# ── SELinux / firewall — kept enforcing/on; DB port opened later ─
selinux --enforcing
firewall --enabled --service=ssh

skipx
eula --agreed

%packages
@^minimal-environment
kexec-tools
chrony
policycoreutils-python-utils
unzip
tar
sudo
# Phase 1 — Oracle DB prerequisite packages (README "Known Issues":
# oracle-database-preinstall-23ai is NOT available on OL10, so these
# are installed manually instead)
elfutils-libelf-devel
fontconfig-devel
glibc-devel
ksh
libaio-devel
libnsl
libstdc++-devel
libXrender-devel
make
gcc
binutils
nfs-utils
smartmontools
sysstat
xorg-x11-xauth
openssl
openssl-libs
libxcrypt-compat
%end

%post --log=/root/ks-post.log

# ── Phase 2 — Groups and oracle user ─────────────────────────────
groupadd -g 54321 oinstall
groupadd -g 54322 dba
groupadd -g 54323 oper
groupadd -g 54324 backupdba
groupadd -g 54325 dgdba
groupadd -g 54326 kmdba
groupadd -g 54327 racdba

useradd -u 54321 -g oinstall \
  -G dba,oper,backupdba,dgdba,kmdba,racdba \
  -d /home/oracle -m -s /bin/bash oracle

# Lock the oracle account password; deploy-oracle-db.sh runs as
# huber via sudo -u oracle, no interactive login needed.
passwd -l oracle

# ── Phase 3 — Kernel parameters ──────────────────────────────────
cat > /etc/sysctl.d/97-oracle-db.conf << 'EOF'
fs.aio-max-nr = 1048576
fs.file-max = 6815744
kernel.shmall = 2097152
kernel.shmmax = 4294967295
kernel.shmmni = 4096
kernel.sem = 250 32000 100 128
net.ipv4.ip_local_port_range = 9000 65500
net.core.rmem_default = 262144
net.core.rmem_max = 4194304
net.core.wmem_default = 262144
net.core.wmem_max = 1048576
EOF

# ── Phase 4 — Security limits ────────────────────────────────────
cat > /etc/security/limits.d/97-oracle-db.conf << 'EOF'
oracle   soft   nofile    1024
oracle   hard   nofile    65536
oracle   soft   nproc     16384
oracle   hard   nproc     16384
oracle   soft   stack     10240
oracle   hard   stack     32768
oracle   hard   memlock   134217728
oracle   soft   memlock   134217728
EOF

# ── Phase 5 — Disable Transparent Hugepages ──────────────────────
cat > /etc/systemd/system/disable-thp.service << 'EOF'
[Unit]
Description=Disable Transparent Huge Pages

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/enabled'
ExecStart=/bin/sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/defrag'

[Install]
WantedBy=multi-user.target
EOF
systemctl enable disable-thp

# ── Phase 6 — Directories ────────────────────────────────────────
mkdir -p /u01/app/oracle/product/23ai/dbhome_1
mkdir -p /u01/app/oraInventory
mkdir -p /u01/app/oracle/oradata
chown -R oracle:oinstall /u01
chmod -R 775 /u01

# sysctl values apply at next boot; also apply now for good measure
sysctl --system || true

%end

